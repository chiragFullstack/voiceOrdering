# ---------------------------------------------------------------------------
# Smash & Go voice order — environment
# Every value below is OPTIONAL. The app runs with zero configuration.
# Copy to `.env.local` (development) or set on your server, then restart.
# ---------------------------------------------------------------------------

# Idle lifetime of a call session, in minutes. Expired sessions are swept.
SESSION_TTL_MINUTES=30

# Max number of concurrent call sessions held in memory (back-pressure guard).
MAX_SESSIONS=500

# Per-IP request budget for the turn endpoint.
RATE_LIMIT_MAX_REQUESTS=90
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: append each confirmed order as JSON Lines to this directory.
# Leave unset on read-only/serverless filesystems — persistence then no-ops.
# ORDER_LOG_DIR=./data/orders

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
